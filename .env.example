# ===========================================================================
# Copy this file to `.env` and fill in real values.
#
# EXPO_PUBLIC_* variables are inlined by Expo at bundle time and can be used by
# the app (see src/constants/update.ts -> UPDATE_API_BASE_URL).
# The remaining CLOUDFLARE_* / R2_* variables are used by the release tooling.
# ===========================================================================

# Cloudflare Worker version-check API base URL (the app hits /api/version).
# Leave unset in a dev build to use the default placeholder.
EXPO_PUBLIC_UPDATE_API_URL=https://update.example.com

# --- Cloudflare Worker deployment (cloudflare/worker) ----------------------
CLOUDFLARE_ACCOUNT_ID=a_placeholder_account_id
CLOUDFLARE_API_TOKEN=a_placeholder_token

# --- R2 (APK storage) ------------------------------------------------------
R2_BUCKET_NAME=memeplan-apks
R2_PUBLIC_URL=https://download.example.com

# --- KV (version metadata) -------------------------------------------------
# The Worker's VERSION_KV namespace id (see cloudflare/worker/wrangler.toml).
CLOUDFLARE_KV_NAMESPACE_ID=00000000000000000000000000000000